          "http": {
            "method": "DELETE",
            "url": "https://{host}:{port}{base_path}/api/v1/span_mapper_groups/:groupId/span_mappers/:mapperId",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path"
