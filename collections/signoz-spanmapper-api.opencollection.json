              },
              {
                "name": "enabled",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "SigNoz-Api-Key",
              "value": "{{SigNoz-Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns all span attribute mapping groups for the authenticated org."
        },
        {
          "info": {
            "name": "Create a span attribute mapping group",
            "type": "http"
