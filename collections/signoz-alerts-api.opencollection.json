{
  "opencollection": "1.0.0",
  "info": {
    "name": "SigNoz alerts API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}:{port}{base_path}/api/v1/alerts",
            "auth": {
              "type": "apikey",
              "key": "SigNoz-Api-Key",
              "value": "{{SigNoz-Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint returns alerts for the organization"
        }
      ]
    }
  ],
  "bundled": true
}